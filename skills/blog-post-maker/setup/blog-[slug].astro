---
// Copy to: src/pages/blog/[slug].astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter((p) => !p.data.draft);
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
const { Content } = await post.render();
const { data } = post;

const siteOrigin = 'https://replyflow.procsctools.in';
const pageUrl = `${siteOrigin}/blog/${post.slug}`;
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const related = (await getCollection('blog'))
  .filter((p) => !p.data.draft && p.slug !== post.slug && p.data.category === data.category)
  .slice(0, 3);

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: siteOrigin },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteOrigin}/blog` },
    { '@type': 'ListItem', position: 3, name: data.title, item: pageUrl },
  ],
};
const postJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  mainEntityOfPage: pageUrl,
  headline: data.title,
  description: data.description,
  image: data.cover ? new URL(data.cover, siteOrigin).href : undefined,
  datePublished: data.publishDate.toISOString(),
  dateModified: (data.updatedDate || data.publishDate).toISOString(),
  author: { '@type': 'Organization', name: data.author, url: siteOrigin },
  publisher: { '@type': 'Organization', name: 'ReplyFlow', url: siteOrigin, logo: { '@type': 'ImageObject', url: `${siteOrigin}/favicon.svg` } },
};
---

<BaseLayout
  title={data.meta_title || `${data.title} | ReplyFlow Blog`}
  description={data.meta_description || data.description}
  image={data.cover || '/og-image.svg'}
  type="article"
  canonicalUrl={pageUrl}
  jsonLd={[breadcrumbJsonLd, postJsonLd]}
>
  <article class="mx-auto max-w-3xl space-y-8 pb-16">
    <Breadcrumbs items={[{ label: 'Blog', href: '/blog' }, { label: data.title }]} />

    <header class="space-y-4">
      <span class="inline-block rounded-full bg-blue-50 px-3 py-1 text-sm font-bold text-primary dark:bg-slate-700 dark:text-blue-300">{data.category}</span>
      <h1 class="text-3xl sm:text-5xl font-black leading-[1.1] tracking-tight text-text dark:text-white">{data.title}</h1>
      <p class="text-base sm:text-lg text-text-muted dark:text-slate-300">{data.description}</p>
      <div class="flex items-center gap-3 text-sm text-text-muted dark:text-slate-400">
        <span class="font-semibold text-text dark:text-slate-200">{data.author}</span>
        <span>·</span>
        <time datetime={data.publishDate.toISOString()}>{fmt(data.publishDate)}</time>
      </div>
    </header>

    {data.cover && (
      <img src={data.cover} alt={data.coverAlt || data.title} class="w-full rounded-[2rem] border border-border/70 dark:border-slate-700/70 shadow-sm" />
    )}

    <div class="rf-prose">
      <Content />
    </div>

    <!-- CTA -->
    <div class="relative overflow-hidden rounded-[2rem] bg-gradient-to-r from-blue-600 to-indigo-600 p-8 text-white shadow-xl">
      <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/10 blur-2xl"></div>
      <div class="relative space-y-3">
        <h3 class="text-2xl font-extrabold">Ready-to-use message templates →</h3>
        <p class="text-blue-100">Copy high-converting WhatsApp, SMS & Email templates for your business in seconds.</p>
        <a href="/search" class="inline-block rounded-2xl bg-white px-6 py-3 text-sm font-extrabold text-primary transition-transform hover:-translate-y-0.5">Browse templates</a>
      </div>
    </div>

    {related.length > 0 && (
      <section class="space-y-4 border-t border-border dark:border-slate-800 pt-8">
        <h2 class="text-xl font-bold text-text dark:text-white">More in {data.category}</h2>
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          {related.map((r) => (
            <a href={`/blog/${r.slug}`} class="group rounded-2xl border border-border/80 dark:border-slate-700/70 bg-white dark:bg-slate-800/80 p-4 transition-all hover:-translate-y-0.5 hover:border-primary/40">
              <h3 class="line-clamp-2 text-sm font-bold text-text group-hover:text-primary dark:text-white">{r.data.title}</h3>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>

<style is:global>
  /* Brand prose styling — keeps every article on-brand in light & dark mode */
  .rf-prose { color: #111827; font-size: 1.0625rem; line-height: 1.75; }
  .dark .rf-prose { color: #e2e8f0; }
  .rf-prose > * + * { margin-top: 1.25rem; }
  .rf-prose h2 { font-family: 'Outfit', 'Inter', sans-serif; font-size: 1.75rem; font-weight: 800; letter-spacing: -0.02em; margin-top: 2.5rem; margin-bottom: 0.75rem; color: #111827; }
  .rf-prose h3 { font-family: 'Outfit', 'Inter', sans-serif; font-size: 1.3rem; font-weight: 700; margin-top: 1.75rem; margin-bottom: 0.5rem; color: #111827; }
  .dark .rf-prose h2, .dark .rf-prose h3 { color: #ffffff; }
  .rf-prose a { color: #2563EB; font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
  .dark .rf-prose a { color: #60a5fa; }
  .rf-prose strong { color: #111827; font-weight: 700; }
  .dark .rf-prose strong { color: #ffffff; }
  .rf-prose ul, .rf-prose ol { padding-left: 1.5rem; }
  .rf-prose ul { list-style: disc; }
  .rf-prose ol { list-style: decimal; }
  .rf-prose li { margin-top: 0.4rem; }
  .rf-prose blockquote { border-left: 4px solid #2563EB; background: #F9FAFB; padding: 0.75rem 1.25rem; border-radius: 0 0.75rem 0.75rem 0; color: #374151; }
  .dark .rf-prose blockquote { background: #1E293B; color: #cbd5e1; }
  .rf-prose code { font-family: 'JetBrains Mono', monospace; font-size: 0.9em; background: #F1F5F9; padding: 0.15rem 0.4rem; border-radius: 0.375rem; color: #1E40AF; }
  .dark .rf-prose code { background: #0f172a; color: #93c5fd; }
  .rf-prose pre { background: #0f172a; color: #e2e8f0; padding: 1.25rem; border-radius: 1rem; overflow-x: auto; }
  .rf-prose pre code { background: none; padding: 0; color: inherit; }
  .rf-prose img { border-radius: 1rem; border: 1px solid #E5E7EB; margin-top: 1.5rem; }
  .dark .rf-prose img { border-color: #334155; }
  .rf-prose table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  .rf-prose th, .rf-prose td { border: 1px solid #E5E7EB; padding: 0.6rem 0.85rem; text-align: left; }
  .dark .rf-prose th, .dark .rf-prose td { border-color: #334155; }
  .rf-prose th { background: #F9FAFB; font-weight: 700; }
  .dark .rf-prose th { background: #1E293B; }
</style>
