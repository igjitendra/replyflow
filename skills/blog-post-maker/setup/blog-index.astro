---
// Copy to: src/pages/blog/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const siteOrigin = 'https://replyflow.procsctools.in';
const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' });

const blogJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'ReplyFlow Blog',
  url: `${siteOrigin}/blog`,
  blogPost: posts.slice(0, 20).map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    datePublished: p.data.publishDate.toISOString(),
    url: `${siteOrigin}/blog/${p.slug}`,
  })),
};
---

<BaseLayout
  title="ReplyFlow Blog — WhatsApp Marketing, Templates & Automation Guides"
  description="Actionable guides on WhatsApp marketing, business message templates, automation and lead generation for Indian local businesses."
  jsonLd={blogJsonLd}
>
  <div class="space-y-8 pb-16">
    <Breadcrumbs items={[{ label: 'Blog' }]} />

    <!-- Header banner -->
    <div class="relative overflow-hidden rounded-[2rem] border border-border/70 dark:border-slate-700/70 bg-gradient-to-br from-white via-blue-50/40 to-indigo-50/30 dark:from-slate-800/90 dark:via-slate-800/70 dark:to-slate-900/80 p-7 sm:p-10 shadow-sm">
      <div class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-primary/10 blur-3xl"></div>
      <div class="relative space-y-2">
        <span class="text-sm font-bold uppercase tracking-wider text-primary">ReplyFlow Blog</span>
        <h1 class="text-3xl sm:text-5xl font-black tracking-tight text-text dark:text-white">
          Guides to <span class="bg-gradient-to-r from-blue-600 to-indigo-600 bg-clip-text text-transparent">grow with messaging</span>
        </h1>
        <p class="max-w-2xl text-sm sm:text-base text-text-muted dark:text-slate-400">
          WhatsApp marketing, template strategy, automation & SEO — written for Indian local businesses.
        </p>
      </div>
    </div>

    {posts.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            class="group flex flex-col overflow-hidden rounded-3xl border border-border/80 dark:border-slate-700/70 bg-white dark:bg-slate-800/80 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-primary/40 hover:shadow-[0_8px_30px_rgba(37,99,235,0.12)]"
          >
            <div class="relative h-44 w-full overflow-hidden bg-slate-100 dark:bg-slate-900">
              {post.data.cover ? (
                <img src={post.data.cover} alt={post.data.coverAlt || post.data.title} loading="lazy" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-blue-600 to-indigo-600 text-2xl font-black text-white">ReplyFlow</div>
              )}
              <span class="absolute left-3 top-3 rounded-full bg-white/90 px-2.5 py-1 text-xs font-bold text-primary shadow-sm backdrop-blur dark:bg-slate-800/90 dark:text-blue-300">{post.data.category}</span>
            </div>
            <div class="flex flex-1 flex-col gap-3 p-5">
              <time class="text-xs font-semibold text-text-muted dark:text-slate-400">{fmt(post.data.publishDate)}</time>
              <h2 class="line-clamp-2 text-lg font-bold leading-snug tracking-tight text-text transition-colors group-hover:text-primary dark:text-white">{post.data.title}</h2>
              <p class="line-clamp-2 text-sm leading-relaxed text-text-muted dark:text-slate-400">{post.data.description}</p>
              <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-semibold text-primary dark:text-blue-400">Read article →</span>
            </div>
          </a>
        ))}
      </div>
    ) : (
      <div class="rounded-3xl border border-border dark:border-slate-700 bg-white dark:bg-slate-800 py-16 text-center">
        <p class="text-4xl">✍️</p>
        <h3 class="mt-3 text-lg font-bold text-text dark:text-white">No posts yet</h3>
        <p class="text-sm text-text-muted dark:text-slate-400">New guides are on the way.</p>
      </div>
    )}
  </div>
</BaseLayout>
