---
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-white/90 backdrop-blur-xl dark:border-white/10 dark:bg-slate-950/90">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-3 px-4 sm:px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label="ReplyFlow home">
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-lg font-extrabold text-white">R</span>
      <span class="font-outfit text-xl font-extrabold tracking-tight text-slate-950 dark:text-white">Reply<span class="text-blue-600 dark:text-blue-400">Flow</span></span>
    </a>

    <nav aria-label="Main navigation" class="hidden items-center gap-1 lg:flex">
      <a href="/" class="header-link">Home</a>
      <a href="/search" class="header-link">Templates</a>
      <a href="/#industries" class="header-link">Industries</a>
      <a href="/channel/whatsapp" class="header-link">Channels</a>
      <a href="/blog" class="header-link">Blog</a>
    </nav>

    <div class="flex items-center gap-1.5">
      <a href="/search" class="header-icon" aria-label="Search templates">
        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
      </a>
      <a href="/ai" class="inline-flex h-10 items-center justify-center gap-2 rounded-xl bg-blue-600 px-3 text-sm font-bold text-white hover:bg-blue-700 sm:px-4">
        <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m10 2 1.4 4.1 4.1 1.4-4.1 1.4L10 13l-1.4-4.1-4.1-1.4 4.1-1.4L10 2Z"/></svg>
        <span class="hidden sm:inline">AI Generator</span>
      </a>
      <button id="theme-toggle-btn" type="button" class="header-icon" aria-label="Switch color theme">
        <svg class="theme-icon-light hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg class="theme-icon-dark h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z"/></svg>
      </button>
      <button id="mobile-menu-btn" type="button" class="header-icon lg:hidden" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
        <svg class="menu-open-icon h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
        <svg class="menu-close-icon hidden h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" aria-label="Mobile navigation" class="hidden border-t border-slate-200 bg-white px-4 py-3 dark:border-white/10 dark:bg-slate-950 lg:hidden">
    <div class="mx-auto grid max-w-7xl gap-1">
      <a href="/" class="mobile-header-link">Home</a>
      <a href="/search" class="mobile-header-link">Templates</a>
      <a href="/#industries" class="mobile-header-link">Industries</a>
      <a href="/channel/whatsapp" class="mobile-header-link">Channels</a>
      <a href="/blog" class="mobile-header-link">Blog</a>
    </div>
  </nav>
</header>

<style>
  .header-link { @apply rounded-lg px-3 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-300 dark:hover:bg-white/10 dark:hover:text-white; }
  .header-icon { @apply flex h-10 w-10 items-center justify-center rounded-xl text-slate-500 hover:bg-slate-100 hover:text-slate-950 dark:text-slate-400 dark:hover:bg-white/10 dark:hover:text-white; }
  .mobile-header-link { @apply rounded-xl px-3 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-100 dark:text-slate-200 dark:hover:bg-white/10; }
</style>

<script>
  function setupHeader() {
    const menuButton = document.getElementById('mobile-menu-btn');
    const menu = document.getElementById('mobile-menu');
    const themeButton = document.getElementById('theme-toggle-btn');

    if (menuButton && menu && !menuButton.dataset.bound) {
      menuButton.dataset.bound = 'true';
      menuButton.addEventListener('click', () => {
        const open = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.querySelector('.menu-open-icon')?.classList.toggle('hidden', open);
        menuButton.querySelector('.menu-close-icon')?.classList.toggle('hidden', !open);
      });
    }

    const updateThemeIcon = () => {
      const dark = document.documentElement.classList.contains('dark');
      themeButton?.querySelector('.theme-icon-light')?.classList.toggle('hidden', !dark);
      themeButton?.querySelector('.theme-icon-dark')?.classList.toggle('hidden', dark);
    };

    if (themeButton && !themeButton.dataset.bound) {
      themeButton.dataset.bound = 'true';
      themeButton.addEventListener('click', () => {
        const dark = !document.documentElement.classList.contains('dark');
        document.documentElement.classList.toggle('dark', dark);
        localStorage.setItem('rf_theme', dark ? 'dark' : 'light');
        updateThemeIcon();
      });
    }
    updateThemeIcon();
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
