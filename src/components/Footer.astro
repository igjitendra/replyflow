---
import defaultSettings from '../data/settings.json';
---

<footer class="mt-auto border-t border-slate-200 bg-white dark:border-white/10 dark:bg-slate-950">
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="flex flex-col gap-8 md:flex-row md:items-start md:justify-between">
      <div class="max-w-md">
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="ReplyFlow home">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-blue-600 text-lg font-extrabold text-white">R</span>
          <span class="font-outfit text-xl font-extrabold tracking-tight text-slate-950 dark:text-white">Reply<span class="text-blue-600 dark:text-blue-400">Flow</span></span>
        </a>
        <p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">
          Ready-to-use business message templates for WhatsApp, SMS, Email and DMs.
        </p>
      </div>

      <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-x-10 gap-y-3 text-sm font-semibold text-slate-600 dark:text-slate-300 sm:flex sm:flex-wrap sm:justify-end sm:gap-x-6">
        <a href="/" class="hover:text-blue-600 dark:hover:text-blue-400">Home</a>
        <a href="/search" class="hover:text-blue-600 dark:hover:text-blue-400">Templates</a>
        <a href="/blog" class="hover:text-blue-600 dark:hover:text-blue-400">Blog</a>
        <a href="/ai" class="hover:text-blue-600 dark:hover:text-blue-400">AI Generator</a>
        <a href="/about" class="hover:text-blue-600 dark:hover:text-blue-400">About</a>
        <a href="/privacy" class="hover:text-blue-600 dark:hover:text-blue-400">Privacy</a>
        <a href="/terms" class="hover:text-blue-600 dark:hover:text-blue-400">Terms</a>
      </nav>
    </div>

    <div class="mt-8 flex flex-col gap-3 border-t border-slate-200 pt-6 text-xs text-slate-500 dark:border-white/10 dark:text-slate-500 sm:flex-row sm:items-center sm:justify-between">
      <p>{defaultSettings.copyrightText}</p>
      <div class="flex items-center gap-4">
        <a href="/sitemap.xml" class="hover:text-blue-600">Sitemap</a>
        <a href="/rss.xml" class="hover:text-blue-600">RSS</a>
      </div>
    </div>
  </div>
</footer>
