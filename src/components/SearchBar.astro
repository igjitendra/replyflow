---
interface Props {
  placeholder?: string;
  initialValue?: string;
  autofocus?: boolean;
}

const {
  placeholder = 'Search templates by keyword (e.g. "follow-up", "diwali", "real estate")...',
  initialValue = '',
  autofocus = false,
} = Astro.props;
---

<div class="search-bar-wrapper max-w-2xl mx-auto w-full relative">
  <form action="/search" method="GET" class="relative flex items-center">
    <!-- Search Icon -->
    <div class="absolute left-4 pointer-events-none text-slate-400 dark:text-slate-500">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
    </div>

    <!-- Input Field -->
    <input
      type="text"
      name="q"
      id="search-input"
      value={initialValue}
      placeholder={placeholder}
      autofocus={autofocus}
      autocomplete="off"
      class="w-full min-h-[58px] pl-12 pr-24 py-4 text-[15px] bg-white/95 dark:bg-slate-900/95 border border-slate-200 dark:border-white/10 rounded-2xl shadow-[0_12px_36px_-18px_rgba(15,23,42,.35)] hover:border-blue-300 focus:border-blue-500 dark:focus:border-blue-400 focus:outline-none focus:ring-4 focus:ring-blue-500/10 text-text dark:text-white placeholder-slate-400 dark:placeholder-slate-500 transition-all"
    />

    <!-- Clear & Shortcut Kbd Badge -->
    <div class="absolute right-3 flex items-center gap-2">
      <button
        type="button"
        id="search-clear-btn"
        class="hidden p-1 text-slate-400 hover:text-slate-600 dark:hover:text-slate-200 rounded-lg"
        aria-label="Clear search query"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>

      <kbd class="hidden sm:inline-flex items-center gap-1 px-2 py-1 text-[11px] font-semibold text-slate-400 dark:text-slate-500 bg-slate-100 dark:bg-slate-700/60 border border-slate-200 dark:border-slate-600 rounded-md">
        /
      </kbd>
    </div>
  </form>
</div>

<script>
  function setupSearchBar() {
    const input = document.getElementById('search-input') as HTMLInputElement | null;
    const clearBtn = document.getElementById('search-clear-btn');

    if (!input) return;

    const toggleClear = () => {
      if (clearBtn) {
        if (input.value.length > 0) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    };

    input.addEventListener('input', toggleClear);
    toggleClear();

    if (clearBtn) {
      clearBtn.addEventListener('click', () => {
        input.value = '';
        input.focus();
        toggleClear();
      });
    }

    // Keyboard shortcut '/' to focus search input
    document.addEventListener('keydown', (e) => {
      if (e.key === '/' && document.activeElement !== input && !['INPUT', 'TEXTAREA'].includes((document.activeElement as HTMLElement)?.tagName)) {
        e.preventDefault();
        input.focus();
      }
    });
  }

  setupSearchBar();
  document.addEventListener('astro:page-load', setupSearchBar);
</script>
