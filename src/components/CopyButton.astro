---
interface Props {
  text: string;
  variables?: string[];
  buttonText?: string;
  variant?: 'primary' | 'secondary' | 'outline' | 'icon';
  className?: string;
  templateId?: string;
  id?: string;
}


const {
  text,
  variables = [],
  buttonText = 'Copy Message',
  variant = 'primary',
  className = '',
  templateId = Math.random().toString(36).substring(2, 9),
} = Astro.props;

const baseStyles = 'inline-flex items-center justify-center font-medium rounded-lg transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-primary focus:ring-offset-2 active:scale-95 cursor-pointer disabled:opacity-50 disabled:cursor-not-allowed';

const variantStyles = {
  primary: 'bg-primary hover:bg-primary-dark text-white px-4 py-2.5 shadow-sm text-sm',
  secondary: 'bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 shadow-sm text-sm',
  outline: 'border border-border dark:border-slate-700 hover:bg-surface dark:hover:bg-slate-800 text-text dark:text-slate-200 px-3.5 py-2 text-sm',
  icon: 'p-2 text-text-muted hover:text-text hover:bg-surface dark:hover:bg-slate-800 rounded-lg text-sm',
};
---

<div class="copy-button-container relative inline-block" data-template-id={templateId} data-raw-text={text} data-variables={JSON.stringify(variables)}>
  <button
    type="button"
    class={`copy-btn ${baseStyles} ${variantStyles[variant]} ${className}`}
    aria-label={buttonText}
  >
    <svg class="copy-icon w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
    </svg>
    <svg class="check-icon hidden w-4 h-4 mr-2 text-white stroke-current" fill="none" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
    </svg>
    <span class="btn-text">{buttonText}</span>
  </button>

  <!-- Success Toast Feedback -->
  <div class="copy-toast opacity-0 pointer-events-none transition-all duration-300 absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-1.5 bg-slate-900 text-white text-xs font-semibold rounded-md shadow-lg flex items-center gap-1.5 whitespace-nowrap z-50">
    <svg class="w-3.5 h-3.5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
    </svg>
    Copied to clipboard!
  </div>
</div>

<script>
  function setupCopyButtons() {
    const containers = document.querySelectorAll('.copy-button-container');

    containers.forEach((container) => {
      const btn = container.querySelector('.copy-btn');
      const toast = container.querySelector('.copy-toast');
      const copyIcon = container.querySelector('.copy-icon');
      const checkIcon = container.querySelector('.check-icon');
      const btnText = container.querySelector('.btn-text');

      if (!btn || btn.getAttribute('data-listener-attached')) return;
      btn.setAttribute('data-listener-attached', 'true');

      btn.addEventListener('click', async () => {
        // Find if associated ChatPreview or variable inputs exist
        let textToCopy = container.getAttribute('data-raw-text') || '';
        
        // Search parent card for active variable inputs if present
        const card = container.closest('.template-card, .chat-preview-container, body');
        if (card) {
          const varInputs = card.querySelectorAll<HTMLInputElement>('input[data-var-name]');
          varInputs.forEach((input) => {
            const varName = input.getAttribute('data-var-name');
            const val = input.value.trim() || `{{${varName}}}`;
            if (varName) {
              const regex = new RegExp(`\\{\\{\\s*${varName}\\s*\\}\\}`, 'g');
              textToCopy = textToCopy.replace(regex, val);
            }
          });
        }

        try {
          await navigator.clipboard.writeText(textToCopy);

          // Visual Feedback
          if (copyIcon) copyIcon.classList.add('hidden');
          if (checkIcon) checkIcon.classList.remove('hidden');
          if (toast) {
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100', '-translate-y-1');
          }
          if (btnText && btnText.textContent === 'Copy Message') {
            btnText.textContent = 'Copied!';
          }

          setTimeout(() => {
            if (copyIcon) copyIcon.classList.remove('hidden');
            if (checkIcon) checkIcon.classList.add('hidden');
            if (toast) {
              toast.classList.add('opacity-0', 'pointer-events-none');
              toast.classList.remove('opacity-100', '-translate-y-1');
            }
            if (btnText && btnText.textContent === 'Copied!') {
              btnText.textContent = 'Copy Message';
            }
          }, 2000);
        } catch (err) {
          console.error('Failed to copy text: ', err);
        }
      });
    });
  }

  setupCopyButtons();
  document.addEventListener('astro:page-load', setupCopyButtons);
</script>
