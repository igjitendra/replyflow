---
import channelsData from '../data/channels.json';
import tonesData from '../data/tones.json';

interface Props {
  selectedChannel?: string;
  selectedTone?: string;
  selectedLanguage?: string;
  className?: string;
}

const {
  selectedChannel = '',
  selectedTone = '',
  selectedLanguage = '',
  className = '',
} = Astro.props;

const languages = [
  { slug: '', name: 'All Languages' },
  { slug: 'hi', name: 'Hindi (हिंदी)' },
  { slug: 'en', name: 'English' },
  { slug: 'hinglish', name: 'Hinglish' },
];
---

<div class={`filter-bar bg-white dark:bg-slate-800 rounded-2xl border border-border dark:border-slate-700/80 p-4 shadow-sm space-y-3 ${className}`}>
  <div class="flex items-center justify-between">
    <div class="flex items-center gap-2 text-xs font-semibold text-text dark:text-slate-200">
      <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z"/>
      </svg>
      Filter Templates
    </div>

    <button
      type="button"
      id="reset-filters-btn"
      class="text-xs font-medium text-text-muted hover:text-danger dark:text-slate-400 dark:hover:text-rose-400 transition-colors"
    >
      Reset Filters
    </button>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    <!-- Channel Filter Dropdown -->
    <div>
      <label class="block text-[11px] font-medium text-text-muted dark:text-slate-400 mb-1">
        Channel
      </label>
      <select
        id="filter-channel"
        class="w-full px-3 py-2 text-xs bg-surface dark:bg-slate-900 border border-border dark:border-slate-700 rounded-xl text-text dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"
      >
        <option value="">All Channels</option>
        {channelsData.map((c) => (
          <option value={c.slug} selected={c.slug === selectedChannel}>
            {c.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Tone Filter Dropdown -->
    <div>
      <label class="block text-[11px] font-medium text-text-muted dark:text-slate-400 mb-1">
        Tone
      </label>
      <select
        id="filter-tone"
        class="w-full px-3 py-2 text-xs bg-surface dark:bg-slate-900 border border-border dark:border-slate-700 rounded-xl text-text dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"
      >
        <option value="">All Tones</option>
        {tonesData.map((t) => (
          <option value={t.slug} selected={t.slug === selectedTone}>
            {t.name}
          </option>
        ))}
      </select>
    </div>

    <!-- Language Filter Dropdown -->
    <div>
      <label class="block text-[11px] font-medium text-text-muted dark:text-slate-400 mb-1">
        Language
      </label>
      <select
        id="filter-language"
        class="w-full px-3 py-2 text-xs bg-surface dark:bg-slate-900 border border-border dark:border-slate-700 rounded-xl text-text dark:text-slate-200 focus:outline-none focus:ring-2 focus:ring-primary/20 focus:border-primary"
      >
        {languages.map((l) => (
          <option value={l.slug} selected={l.slug === selectedLanguage}>
            {l.name}
          </option>
        ))}
      </select>
    </div>
  </div>
</div>

<script>
  function setupFilterBar() {
    const channelSel = document.getElementById('filter-channel') as HTMLSelectElement | null;
    const toneSel = document.getElementById('filter-tone') as HTMLSelectElement | null;
    const langSel = document.getElementById('filter-language') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('reset-filters-btn');

    const triggerFilterEvent = () => {
      const detail = {
        channel: channelSel?.value || '',
        tone: toneSel?.value || '',
        language: langSel?.value || '',
      };
      
      const event = new CustomEvent('replyflow:filter', { detail, bubbles: true });
      document.dispatchEvent(event);
    };

    channelSel?.addEventListener('change', triggerFilterEvent);
    toneSel?.addEventListener('change', triggerFilterEvent);
    langSel?.addEventListener('change', triggerFilterEvent);

    resetBtn?.addEventListener('click', () => {
      if (channelSel) channelSel.value = '';
      if (toneSel) toneSel.value = '';
      if (langSel) langSel.value = '';
      triggerFilterEvent();
    });
  }

  setupFilterBar();
  document.addEventListener('astro:page-load', setupFilterBar);
</script>
