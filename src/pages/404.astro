---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — ReplyFlow" description="The page you requested could not be found." robots="noindex, nofollow">
  <section class="mx-auto flex min-h-[60vh] max-w-xl flex-col items-center justify-center text-center">
    <span class="text-sm font-extrabold uppercase tracking-[.18em] text-blue-600">Error 404</span>
    <h1 class="mt-4 font-outfit text-5xl font-extrabold tracking-tight text-slate-950 dark:text-white">This page has moved or does not exist.</h1>
    <p class="mt-5 leading-7 text-slate-600 dark:text-slate-300">Browse the template library, select an industry, or create a fresh message with AI.</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3"><a href="/" class="rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white dark:bg-white dark:text-slate-950">Go home</a><a href="/search" class="rounded-xl border border-slate-200 px-5 py-3 text-sm font-bold dark:border-white/15">Search templates</a></div>
  </section>
</BaseLayout>
