---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TemplateCard from '../../components/TemplateCard.astro';
import FilterBar from '../../components/FilterBar.astro';

import { getCollection, type CollectionEntry } from 'astro:content';

interface FestivalItem {
  slug: string;
  name: string;
  emoji: string;
  date: string;
}

interface Props {
  festival: FestivalItem;
  templates: CollectionEntry<'templates'>[];
}

const festivalList: FestivalItem[] = [

  { slug: 'diwali', name: 'Diwali & Dhanteras Wishes', emoji: '🪔', date: 'October/November' },
  { slug: 'holi', name: 'Holi Greetings', emoji: '🎨', date: 'March' },
  { slug: 'eid', name: 'Eid Mubarak Greetings', emoji: '🌙', date: 'April/May' },
  { slug: 'new-year', name: 'New Year & Year-End Offers', emoji: '🎆', date: 'December/January' },
  { slug: 'independence-day', name: 'Independence Day Sales', emoji: '🇮🇳', date: 'August 15' },
];

export async function getStaticPaths() {
  const allTemplates = await getCollection('templates', ({ data }) => !data.draft);
  const festivals = [
    { slug: 'diwali', name: 'Diwali & Dhanteras Wishes', emoji: '🪔', date: 'October/November' },
    { slug: 'holi', name: 'Holi Greetings', emoji: '🎨', date: 'March' },
    { slug: 'eid', name: 'Eid Mubarak Greetings', emoji: '🌙', date: 'April/May' },
    { slug: 'new-year', name: 'New Year & Year-End Offers', emoji: '🎆', date: 'December/January' },
    { slug: 'independence-day', name: 'Independence Day Sales', emoji: '🇮🇳', date: 'August 15' },
  ];

  return festivals.map((fest) => {
    // Find matching templates by tags or purpose
    const festivalTemplates = allTemplates.filter((t) =>
      t.data.tags.some((tag) => tag.toLowerCase().includes(fest.slug) || tag.toLowerCase().includes('festival') || tag.toLowerCase().includes('offer'))
    );
    return {
      params: { slug: fest.slug },
      props: { festival: fest, templates: festivalTemplates },
    };
  });
}

const { festival, templates } = Astro.props;

const siteOrigin = 'https://replyflow.procsctools.in';
const pageUrl = `${siteOrigin}/festivals/${festival.slug}`;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: siteOrigin,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: festival.name,
      item: pageUrl,
    },
  ],
};

const collectionJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${festival.name} Festive Business Wishes & Offer Templates`,
  url: pageUrl,
  description: `Festive wish templates & promotional offers for ${festival.name}. Send personalized WhatsApp & SMS wishes to your customers.`,
};
---

<BaseLayout
  title={`${festival.name} Business Wishes & Offer Templates — ReplyFlow`}
  description={`Festive wish templates & promotional offers for ${festival.name}. Send personalized WhatsApp & SMS wishes to your customers in Hindi, Hinglish & English.`}
  keywords={`${festival.name} wishes, ${festival.name} business offer templates, whatsapp festive greetings, festival discount templates`}
  canonicalUrl={pageUrl}
  jsonLd={[breadcrumbJsonLd, collectionJsonLd]}
>

  <div class="space-y-8 pb-12">
    <!-- Breadcrumbs -->
    <Breadcrumbs items={[{ label: 'Festivals', href: '/' }, { label: festival.name }]} />

    <!-- Festival Campaign Header -->
    <div class="bg-gradient-to-r from-amber-500 via-rose-500 to-purple-600 rounded-3xl p-6 sm:p-10 text-white shadow-lg space-y-3">
      <div class="flex items-center gap-3">
        <span class="text-4xl">{festival.emoji}</span>
        <div>
          <span class="px-2.5 py-0.5 text-[11px] font-bold rounded-full bg-white/20 backdrop-blur">
            Seasonal Campaign • {festival.date}
          </span>
          <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight mt-1">
            {festival.name} Templates
          </h1>
        </div>
      </div>
      <p class="text-sm sm:text-base text-amber-50 max-w-2xl">
        Delight your customers with warm festive wishes, exclusive festival discount offers, and seasonal reminder messages.
      </p>
    </div>

    <!-- Quick Festival Switcher -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 text-xs">
      <span class="font-semibold text-text-muted dark:text-slate-400 whitespace-nowrap">Festivals:</span>
      {festivalList.map((f) => (
        <a
          href={`/festivals/${f.slug}`}
          class={`px-3 py-1.5 rounded-xl font-medium whitespace-nowrap border transition-colors ${
            f.slug === festival.slug
              ? 'bg-primary text-white border-primary'
              : 'bg-white dark:bg-slate-800 text-text dark:text-slate-300 border-border dark:border-slate-700 hover:border-primary'
          }`}
        >
          {f.emoji} {f.name}
        </a>
      ))}
    </div>

    <!-- FilterBar -->
    <FilterBar />

    <!-- Templates Grid -->
    {templates.length > 0 ? (
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        {templates.map((template) => (
          <TemplateCard template={template} />
        ))}
      </div>
    ) : (
      <div class="text-center py-12 bg-white dark:bg-slate-800 rounded-2xl border border-border dark:border-slate-700 space-y-3">
        <p class="text-4xl">🎉</p>
        <h3 class="text-lg font-bold text-text dark:text-white">
          {festival.name} templates arriving soon!
        </h3>
        <p class="text-xs text-text-muted dark:text-slate-400">
          Check out our general promotional & festival templates in the meantime.
        </p>
      </div>
    )}
  </div>
</BaseLayout>
