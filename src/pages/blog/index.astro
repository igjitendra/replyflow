---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a,b) => b.data.published_at.valueOf() - a.data.published_at.valueOf());
const categories = await getCollection('blog-categories');
const categoryMap = new Map(categories.map((c) => [c.slug, c.data.name]));
---
<BaseLayout title="ReplyFlow Blog — Business Messaging & WhatsApp Guides" description="Practical business messaging, WhatsApp marketing and template guides.">
  <section class="mx-auto max-w-6xl space-y-10 pb-20">
    <header class="rounded-[2rem] border border-slate-200 bg-white p-8 sm:p-12 dark:border-white/10 dark:bg-slate-900">
      <span class="text-xs font-bold uppercase tracking-[.16em] text-blue-600">ReplyFlow Blog</span>
      <h1 class="mt-3 font-outfit text-4xl font-extrabold tracking-tight text-slate-950 dark:text-white sm:text-6xl">Better messages. Better business.</h1>
      <p class="mt-4 max-w-2xl text-slate-600 dark:text-slate-300">Actionable guides for WhatsApp, customer communication and high-converting business copy.</p>
      <div class="mt-6 flex flex-wrap gap-2">{categories.map((cat) => <a href={`/blog/category/${cat.slug}`} class="rounded-lg border border-slate-200 px-3 py-2 text-xs font-bold dark:border-white/10">{cat.data.name}</a>)}</div>
    </header>
    {posts.length ? <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">{posts.map((post) => <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white dark:border-white/10 dark:bg-slate-900">{post.data.cover && <img src={post.data.cover} alt="" class="aspect-[16/9] w-full object-cover" />}<div class="p-6"><a href={`/blog/category/${post.data.category}`} class="text-xs font-bold uppercase tracking-wider text-blue-600">{categoryMap.get(post.data.category) || post.data.category}</a><h2 class="mt-2 text-xl font-extrabold text-slate-950 dark:text-white"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2><p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">{post.data.excerpt}</p><a href={`/blog/${post.slug}`} class="mt-5 inline-flex text-sm font-bold text-blue-600">Read article →</a></div></article>)}</div> : <div class="rounded-2xl border border-dashed border-slate-300 p-12 text-center text-slate-500 dark:border-white/15">Publish your first article from the Admin panel.</div>}
  </section>
</BaseLayout>
