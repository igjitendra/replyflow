---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
export async function getStaticPaths(){ const categories=await getCollection('blog-categories'); const posts=await getCollection('blog',({data})=>!data.draft); return categories.map((category)=>({params:{slug:category.slug},props:{category,posts:posts.filter((p)=>p.data.category===category.slug)}})); }
const {category,posts}=Astro.props as {category:CollectionEntry<'blog-categories'>;posts:CollectionEntry<'blog'>[]};
---
<BaseLayout title={`${category.data.name} Articles — ReplyFlow Blog`} description={category.data.description || `Latest ${category.data.name} articles.`}>
<section class="mx-auto max-w-5xl pb-20"><a href="/blog" class="text-sm font-bold text-blue-600">← All articles</a><h1 class="mt-6 font-outfit text-4xl font-extrabold text-slate-950 dark:text-white">{category.data.name}</h1><p class="mt-3 text-slate-600 dark:text-slate-300">{category.data.description}</p><div class="mt-10 grid gap-5 md:grid-cols-2">{posts.map((post)=><article class="rounded-2xl border border-slate-200 bg-white p-6 dark:border-white/10 dark:bg-slate-900"><h2 class="text-xl font-extrabold"><a href={`/blog/${post.slug}`}>{post.data.title}</a></h2><p class="mt-3 text-sm leading-6 text-slate-600 dark:text-slate-400">{post.data.excerpt}</p></article>)}</div></section>
</BaseLayout>
