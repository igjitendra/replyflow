---
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchBar from '../components/SearchBar.astro';
import IndustryCard from '../components/IndustryCard.astro';
import TemplateCard from '../components/TemplateCard.astro';
import ChannelBadge from '../components/ChannelBadge.astro';
import ChatPreview from '../components/ChatPreview.astro';

import { getCollection } from 'astro:content';
import channelsData from '../data/channels.json';
import { TOP_FEATURED_INDUSTRIES } from '../utils/categoryGrouping';

const allTemplates = await getCollection('templates', ({ data }) => !data.draft);
const industryEntries = await getCollection('industries');
const industriesData = industryEntries.map((entry) => ({ ...entry.data, slug: entry.slug })).sort((a, b) => a.order - b.order);

// Compute template counts per industry
const industryCounts: Record<string, number> = {};
allTemplates.forEach((t) => {
  const ind = t.data.industry;
  industryCounts[ind] = (industryCounts[ind] || 0) + 1;
});

const totalTemplates = allTemplates.length;
const featuredTemplates = allTemplates.slice(0, 4);
const heroDemoTemplate = allTemplates.find((t) => t.data.id === 'real-estate-new-lead-friendly-hinglish') || allTemplates[0];

const faqs = [
  {
    q: 'Is ReplyFlow 100% free to use?',
    a: 'Yes. ReplyFlow is completely free for business owners, copywriters, and marketers. Search, customize, and copy as many message templates as you need — no subscription, ever.',
  },
  {
    q: 'Do I need to create an account or log in?',
    a: 'No. ReplyFlow works with zero login or registration. Every template, search function, and AI utility is available 100% anonymously.',
  },
  {
    q: 'How does the AI Generator handle my API key?',
    a: "The AI Generator uses your own Google Gemini, OpenAI, or Anthropic API key. It is stored only in your browser's localStorage and requests travel directly from your device to the provider. We never store or log your key on any server.",
  },
  {
    q: 'Are templates compliant with WhatsApp & SMS rules?',
    a: 'Yes. Templates follow customer-communication best practices. Items marked “WhatsApp Verified” conform to standard Meta Business categories, and SMS templates follow standard DLT format structures.',
  },
];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const topFeatured = industriesData.filter((ind) => TOP_FEATURED_INDUSTRIES.includes(ind.slug));
const extraIndustries = industriesData.filter((ind) => !TOP_FEATURED_INDUSTRIES.includes(ind.slug));

const stats = [
  { value: `${totalTemplates}`, label: 'Templates published' },
  { value: `${industriesData.length}`, label: 'Industries' },
  { value: `${channelsData.length}`, label: 'Channels' },
  { value: '0', label: 'Login required' },
];
---

<BaseLayout
  title="ReplyFlow — Find Business Message Templates for WhatsApp, SMS & Email"
  description="Find, customize & copy ready-to-use business message templates for WhatsApp, SMS, Email, Instagram DMs & Google Reviews in seconds. 100% free, 0 login required."
  keywords="whatsapp templates, business message templates, customer follow up copy, Hinglish whatsapp copy, sms message templates, sales message templates"
  jsonLd={faqJsonLd}
>

  <div class="relative space-y-24 overflow-x-clip pb-20 sm:space-y-32">

    <!-- ============ 1. HERO ============ -->
    <section class="relative -mt-8 isolate min-h-[760px] overflow-hidden rounded-b-[2rem] pt-10 sm:pt-14 lg:min-h-[720px] lg:pt-16">
      <div class="hero-orb hero-orb-one" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-two" aria-hidden="true"></div>
      <div class="premium-grid absolute inset-0 -z-20 opacity-70" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-6xl items-center gap-14 lg:grid-cols-[1.02fr_.98fr] lg:gap-16">
        <div class="max-w-2xl text-center lg:text-left">
          <div class="mb-7 inline-flex items-center gap-2 rounded-full border border-slate-200/80 bg-white/80 px-3 py-1.5 text-xs font-semibold text-slate-600 shadow-sm backdrop-blur dark:border-white/10 dark:bg-white/[.06] dark:text-slate-300">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-100 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300">
              <svg class="h-3 w-3" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.25"><path d="m5 10 3 3 7-7"/></svg>
            </span>
            Free forever · No signup · Built for India
          </div>

          <h1 class="font-outfit text-[2.75rem] font-extrabold leading-[1.02] tracking-[-0.04em] text-slate-950 dark:text-white sm:text-[4rem] lg:text-[4.7rem]">
            Find &amp; Copy the Perfect<br class="hidden sm:block" />
            Business Message <span class="text-blue-600 dark:text-blue-400">in Seconds.</span>
          </h1>

          <p class="mx-auto mt-7 max-w-xl text-[1.05rem] leading-8 text-slate-600 dark:text-slate-300 lg:mx-0">
            Ready-to-use templates for <strong class="font-semibold text-slate-900 dark:text-white">WhatsApp, SMS, Email &amp; DMs</strong>. Search, personalize and copy in one click — in Hindi, English and Hinglish.
          </p>

          <div class="mt-8 max-w-2xl">
            <SearchBar placeholder='Try “payment reminder” or “salon offer”' autofocus={true} />
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-center gap-3 lg:justify-start">
            <a href="#industries" class="premium-button inline-flex min-h-11 items-center justify-center gap-2 rounded-xl bg-slate-950 px-5 py-3 text-sm font-bold text-white shadow-[0_10px_30px_-12px_rgba(15,23,42,.7)] transition hover:-translate-y-0.5 hover:bg-slate-800 focus:outline-none focus:ring-4 focus:ring-blue-500/20 dark:bg-white dark:text-slate-950 dark:hover:bg-slate-100">
              Browse templates
              <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 10h12m-4-4 4 4-4 4"/></svg>
            </a>
            <a href="/ai" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white/80 px-5 py-3 text-sm font-bold text-slate-700 shadow-sm backdrop-blur transition hover:-translate-y-0.5 hover:border-blue-300 hover:text-blue-700 focus:outline-none focus:ring-4 focus:ring-blue-500/15 dark:border-white/10 dark:bg-white/[.06] dark:text-white dark:hover:border-blue-400/50">
              <svg class="h-4 w-4 text-blue-600 dark:text-blue-400" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m10 2 1.4 4.1L15.5 7.5l-4.1 1.4L10 13l-1.4-4.1-4.1-1.4 4.1-1.4L10 2Z"/><path d="m15.5 12 .7 2.1 2.1.7-2.1.7-.7 2.1-.7-2.1-2.1-.7 2.1-.7.7-2.1Z"/></svg>
              Write with AI
            </a>
          </div>

          <div class="mt-8 flex flex-wrap items-center justify-center gap-x-5 gap-y-3 text-xs font-semibold text-slate-500 dark:text-slate-400 lg:justify-start">
            <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>{totalTemplates > 0 ? `${totalTemplates}+ templates` : 'Fresh templates added daily'}</span>
            <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-blue-500"></span>{industriesData.length} industries</span>
            <span class="inline-flex items-center gap-2"><span class="h-1.5 w-1.5 rounded-full bg-violet-500"></span>{channelsData.length} channels</span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[560px] lg:mx-0">
          <div class="absolute -inset-8 -z-10 rounded-[3rem] bg-blue-500/[.08] blur-3xl dark:bg-blue-500/[.12]" aria-hidden="true"></div>
          <div class="hero-product-shell relative overflow-hidden rounded-[1.75rem] border border-white/80 bg-white/85 p-3 shadow-[0_36px_90px_-38px_rgba(15,23,42,.5)] backdrop-blur-xl dark:border-white/10 dark:bg-slate-900/80">
            <div class="flex items-center justify-between border-b border-slate-200/70 px-3 pb-3 dark:border-white/10">
              <div class="flex items-center gap-2">
                <span class="h-2.5 w-2.5 rounded-full bg-rose-400"></span><span class="h-2.5 w-2.5 rounded-full bg-amber-400"></span><span class="h-2.5 w-2.5 rounded-full bg-emerald-400"></span>
              </div>
              <span class="rounded-md bg-slate-100 px-2 py-1 text-[10px] font-bold uppercase tracking-[.14em] text-slate-500 dark:bg-white/[.07] dark:text-slate-400">Live preview</span>
            </div>

            <div class="grid gap-3 p-1 pt-4 sm:grid-cols-[.88fr_1.12fr]">
              <div class="rounded-2xl border border-slate-200/80 bg-slate-50/90 p-4 dark:border-white/10 dark:bg-white/[.035]">
                <div class="mb-4 flex items-center gap-2 text-xs font-bold text-slate-700 dark:text-slate-200">
                  <span class="flex h-7 w-7 items-center justify-center rounded-lg bg-blue-600 text-white">1</span>
                  Personalize
                </div>
                <label class="mb-2 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Customer name</label>
                <div class="rounded-lg border border-blue-200 bg-white px-3 py-2.5 text-sm font-semibold text-slate-800 shadow-sm dark:border-blue-400/30 dark:bg-slate-900 dark:text-white">Priya</div>
                <label class="mb-2 mt-4 block text-[11px] font-bold uppercase tracking-wider text-slate-400">Offer</label>
                <div class="rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 dark:border-white/10 dark:bg-slate-900 dark:text-slate-200">20% welcome discount</div>
                <button type="button" class="mt-4 flex min-h-11 w-full items-center justify-center gap-2 rounded-xl bg-blue-600 px-3 py-2.5 text-sm font-bold text-white shadow-[0_8px_22px_-10px_rgba(37,99,235,.8)]">
                  <svg class="h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="6" width="9" height="9" rx="2"/><path d="M4 12H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1h8a1 1 0 0 1 1 1v1"/></svg>
                  Copy message
                </button>
              </div>

              <div class="relative overflow-hidden rounded-2xl bg-[#e9f1ec] p-4 dark:bg-[#14211b]">
                <div class="absolute inset-0 opacity-30" style="background-image:radial-gradient(circle at 20% 20%,#94a3b8 1px,transparent 1px);background-size:18px 18px" aria-hidden="true"></div>
                <div class="relative mb-4 flex items-center gap-2.5 rounded-xl bg-[#075e54] px-3 py-2.5 text-white shadow-sm">
                  <div class="flex h-8 w-8 items-center justify-center rounded-full bg-white/15 text-xs font-bold">RF</div>
                  <div><div class="text-xs font-bold">ReplyFlow Demo</div><div class="text-[10px] text-white/70">online</div></div>
                </div>
                <div class="relative ml-auto max-w-[95%] rounded-2xl rounded-tr-sm bg-[#dcf8c6] p-3.5 text-[12px] leading-[1.6] text-slate-800 shadow-sm dark:bg-emerald-900/80 dark:text-emerald-50">
                  Hi <strong>Priya</strong> 👋<br /><br />Thanks for reaching out! We’ve saved a <strong>20% welcome discount</strong> just for you.<br /><br />Would you like to see our latest collection?
                  <div class="mt-2 text-right text-[9px] text-slate-500 dark:text-emerald-200/60">10:42 ✓✓</div>
                </div>
                <div class="relative mt-3 grid grid-cols-3 gap-1.5">
                  <span class="rounded-lg bg-white/80 px-2 py-2 text-center text-[9px] font-bold text-slate-600 dark:bg-white/10 dark:text-slate-300">WhatsApp</span>
                  <span class="rounded-lg bg-white/80 px-2 py-2 text-center text-[9px] font-bold text-slate-600 dark:bg-white/10 dark:text-slate-300">Hinglish</span>
                  <span class="rounded-lg bg-white/80 px-2 py-2 text-center text-[9px] font-bold text-slate-600 dark:bg-white/10 dark:text-slate-300">Friendly</span>
                </div>
              </div>
            </div>
          </div>

          <div class="absolute -bottom-6 -left-5 hidden items-center gap-3 rounded-2xl border border-white bg-white/90 px-4 py-3 shadow-xl backdrop-blur sm:flex dark:border-white/10 dark:bg-slate-800/90">
            <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-100 text-emerald-700 dark:bg-emerald-400/15 dark:text-emerald-300">
              <svg class="h-5 w-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"><path d="m4 10 4 4 8-8"/></svg>
            </span>
            <div><div class="text-xs font-extrabold text-slate-900 dark:text-white">Ready to send</div><div class="text-[10px] text-slate-500 dark:text-slate-400">Personalized in seconds</div></div>
          </div>
        </div>
      </div>

      <div class="mx-auto mt-20 max-w-6xl border-t border-slate-200/70 pt-6 dark:border-white/10">
        <p class="mb-4 text-center text-[10px] font-extrabold uppercase tracking-[.2em] text-slate-400 lg:text-left">Works across every customer channel</p>
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-3 lg:justify-start">
          {channelsData.map((c) => (
            <a href={`/channel/${c.slug}`} class="opacity-70 grayscale transition hover:-translate-y-0.5 hover:opacity-100 hover:grayscale-0"><ChannelBadge channel={c.slug} size="sm" /></a>
          ))}
        </div>
      </div>
    </section>

    <!-- ============ 2. HOW IT WORKS ============ -->
    <section class="space-y-14">
      <div class="mx-auto max-w-2xl space-y-3 text-center">
        <span class="text-[13px] font-bold uppercase tracking-[0.15em] text-primary">How it works</span>
        <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-text dark:text-white sm:text-[2.5rem]">
          From blank chat to sent message in three steps
        </h2>
      </div>

      <div class="relative grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- connecting line (desktop) -->
        <div class="pointer-events-none absolute left-0 right-0 top-[52px] hidden border-t border-dashed border-border dark:border-slate-700 md:block"></div>

        <!-- Step 1: Search -->
        <div class="relative flex flex-col items-center gap-5 rounded-3xl border border-border bg-white p-8 text-center shadow-[0_1px_2px_rgba(0,0,0,0.04)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3" />
            </svg>
            <span class="absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white shadow-sm">1</span>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-lg font-bold text-text dark:text-white">Search</h3>
            <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">Browse by industry, channel, or goal and find a proven template in seconds.</p>
          </div>
        </div>

        <!-- Step 2: Personalize -->
        <div class="relative flex flex-col items-center gap-5 rounded-3xl border border-border bg-white p-8 text-center shadow-[0_1px_2px_rgba(0,0,0,0.04)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M4 6h10M18 6h2M4 12h2M10 12h10M4 18h7M15 18h5" /><circle cx="16" cy="6" r="2" /><circle cx="8" cy="12" r="2" /><circle cx="13" cy="18" r="2" />
            </svg>
            <span class="absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white shadow-sm">2</span>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-lg font-bold text-text dark:text-white">Personalize</h3>
            <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">Fill in live variables and preview the exact message before you use it.</p>
          </div>
        </div>

        <!-- Step 3: Copy & send -->
        <div class="relative flex flex-col items-center gap-5 rounded-3xl border border-border bg-white p-8 text-center shadow-[0_1px_2px_rgba(0,0,0,0.04)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="relative flex h-16 w-16 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z" />
            </svg>
            <span class="absolute -right-2 -top-2 flex h-6 w-6 items-center justify-center rounded-full bg-primary text-xs font-bold text-white shadow-sm">3</span>
          </div>
          <div class="space-y-1.5">
            <h3 class="text-lg font-bold text-text dark:text-white">Copy &amp; send</h3>
            <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">One-click copy to any channel — or rewrite instantly with your own AI key.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ============ 2b. WHO IT'S FOR ============ -->
    <section class="space-y-14">
      <div class="mx-auto max-w-2xl space-y-3 text-center">
        <span class="text-[13px] font-bold uppercase tracking-[0.15em] text-primary">Who it's for</span>
        <h2 class="font-outfit text-3xl font-extrabold tracking-tight text-text dark:text-white sm:text-[2.5rem]">
          One library, every kind of business
        </h2>
        <p class="text-base text-text-muted dark:text-slate-400">
          Close deals, book appointments, or run campaigns — there's a proven message ready for every moment.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
        <div class="group space-y-4 rounded-3xl border border-border bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_16px_40px_-24px_rgba(37,99,235,0.5)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l1.8-5h14.4L21 9M4.5 9v9a1 1 0 001 1h13a1 1 0 001-1V9M4 9h16M9.5 19v-5h5v5" /></svg>
          </div>
          <h3 class="text-[17px] font-bold text-text dark:text-white">Local businesses</h3>
          <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">Clinics, salons, restaurants &amp; shops — handle bookings, reminders &amp; offers in seconds.</p>
        </div>
        <div class="group space-y-4 rounded-3xl border border-border bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_16px_40px_-24px_rgba(37,99,235,0.5)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 12a4 4 0 100-8 4 4 0 000 8zM4.5 20.5a7.5 7.5 0 0115 0" /></svg>
          </div>
          <h3 class="text-[17px] font-bold text-text dark:text-white">Freelancers</h3>
          <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">Send polished proposals, follow-ups &amp; payment nudges without overthinking the wording.</p>
        </div>
        <div class="group space-y-4 rounded-3xl border border-border bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_16px_40px_-24px_rgba(37,99,235,0.5)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 19v-1.5a3.5 3.5 0 00-3.5-3.5h-5A3.5 3.5 0 004 17.5V19M9.5 10.5a3.5 3.5 0 100-7 3.5 3.5 0 000 7zM19.5 19v-1.5a3.5 3.5 0 00-2.6-3.4M16 3.6a3.5 3.5 0 010 6.8" /></svg>
          </div>
          <h3 class="text-[17px] font-bold text-text dark:text-white">Agencies</h3>
          <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">Give every account manager on-brand, tested copy for consistent client communication.</p>
        </div>
        <div class="group space-y-4 rounded-3xl border border-border bg-white p-6 transition-all duration-300 hover:-translate-y-1 hover:border-primary/30 hover:shadow-[0_16px_40px_-24px_rgba(37,99,235,0.5)] dark:border-slate-700/70 dark:bg-slate-800/80">
          <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-primary/15 bg-primary/5 text-primary dark:border-primary/25 dark:bg-primary/10">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 16.5l5.5-5.5 3.5 3.5L21 6M15 6h6v6" /></svg>
          </div>
          <h3 class="text-[17px] font-bold text-text dark:text-white">Sales teams</h3>
          <p class="text-sm leading-relaxed text-text-muted dark:text-slate-400">Move leads down the funnel with fast, consistent, high-converting replies.</p>
        </div>
      </div>
    </section>

    <!-- ============ 3. LIVE SANDBOX ============ -->
    <section class="relative mx-auto max-w-5xl">
      <div class="space-y-8 rounded-[2rem] border border-border bg-white p-6 shadow-[0_20px_60px_-30px_rgba(15,23,42,0.25)] dark:border-slate-700/70 dark:bg-slate-800/90 sm:p-10">
        <div class="mx-auto max-w-2xl space-y-3 text-center">
          <div class="inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-1.5 text-[13px] font-semibold text-text-muted dark:border-slate-700 dark:bg-slate-700/50 dark:text-slate-300">
