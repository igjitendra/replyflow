      function initCategoryToggle() {
        const toggleBtn = document.getElementById('toggle-categories-btn');
        const container = document.getElementById('all-industries-container');
        const btnText = document.getElementById('toggle-categories-text');
        const btnIcon = document.getElementById('toggle-categories-icon');

        if (toggleBtn && container && btnText && btnIcon) {
          toggleBtn.addEventListener('click', () => {
            const isHidden = container.classList.contains('hidden');
            if (isHidden) {
              container.classList.remove('hidden');
              btnText.textContent = 'Show top categories only';
              btnIcon.classList.add('rotate-180');
            } else {
              container.classList.add('hidden');
              btnText.textContent = 'See all categories (15+)';
              btnIcon.classList.remove('rotate-180');
            }
          });
        }
      }

      initCategoryToggle();
